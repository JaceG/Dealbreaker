{
  "expo": {
    "name": "Dealbreaker",
    "slug": "dealbreaker",
    "scheme": "dealbreaker",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jace88.dealbreaker",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Dealbreaker needs access to your photo library so you can upload photos to add to your flags if needed.",
        "NSCameraUsageDescription": "Dealbreaker uses the camera so you can take a photo to add to your flags if needed.",
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "google-oauth",
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.255602929152-pjcbt99ocrr14vr7r3c3r1rko77ns74q"
            ]
          },
          {
            "CFBundleURLName": "dealbreaker-scheme",
            "CFBundleURLSchemes": [
              "dealbreaker"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.jace88.dealbreaker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.255602929152-pjcbt99ocrr14vr7r3c3r1rko77ns74q"
        }
      ],
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d4d5b012-6c93-4254-ae41-fbcbef3700e3"
      }
    },
    "owner": "jace88"
  }
}
